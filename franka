workflow_free() {
  local take_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --request) take_args+=("--request"); shift ;;
      --wait)
        [[ $# -ge 2 ]] || die "--wait requires a value"
        take_args+=("--wait" "$2")
        shift 2
        ;;
      -h|--help)
        cat <<'EOF'
usage: franka free [options]

Prepare the API-controlled part of manual guiding:
  1. take or reuse SPoC control
  2. unlock arm joints
  3. switch Desk operating mode to Programming
  4. set Desk hand-guiding mode to free

Options:
  --request          Request control if another owner holds the token
  --wait SECONDS     Control-token wait timeout. Use with --request when needed

After this command succeeds, use the required physical enabling device and hold
the Enabling and Guiding Buttons on the Pilot-Grip.
EOF
        return 0
        ;;
      *) die "unknown option: $1" ;;
    esac
  done

  printf 'preparing robot for manual guiding\n'
  handle_control take "${take_args[@]}" || return $?
  arm_unlock_action || return $?
  desk_switch_operating_mode programming || return $?
  desk_set_guiding_mode free || return $?
  printf 'ready for manual guiding: use the physical enabling device and hold the Enabling and Guiding Buttons on the Pilot-Grip\n'
}

workflow_execution() {
  local take_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --request) take_args+=("--request"); shift ;;
      --wait)
        [[ $# -ge 2 ]] || die "--wait requires a value"
        take_args+=("--wait" "$2")
        shift 2
        ;;
      -h|--help)
        cat <<'EOF'
usage: franka execution [options]

Switch Desk operating mode back to Execution.

Options:
  --request          Request control if another owner holds the token
  --wait SECONDS     Control-token wait timeout. Use with --request when needed
EOF
        return 0
        ;;
      *) die "unknown option: $1" ;;
    esac
  done

  printf 'switching robot to Execution mode\n'
  handle_control take "${take_args[@]}" || return $?
  desk_switch_operating_mode execution || return $?
}

workflow_lock() {
  local fci_status=0 lock_status=0
  [[ "$#" -eq 0 ]] || die "lock does not accept arguments"
  printf 'locking robot\n'
  if fci_action Inactive "deactivate FCI" "FCI deactivated" /api/fci:deactivate; then
    fci_status=0
  else
    fci_status=$?
    printf 'continuing to lock arm\n' >&2
  fi
  if arm_lock_action; then
