#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

# Non-sensitive defaults. Robot-specific connection settings belong in the
# per-user config file created by `franka setup`, or in environment variables.
DEFAULT_HOST=""
DEFAULT_USERNAME=""
DEFAULT_PASSWORD=""
DEFAULT_CONTROL_TOKEN=""
DEFAULT_TIMEOUT="30"
DEFAULT_CONTROL_TAKE_TIMEOUT="1"
DEFAULT_INSECURE=1

CONFIG_DIR="${FRANKA_DESKAPI_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/franka-deskapi}"
CONFIG_FILE="${FRANKA_DESKAPI_CONFIG_FILE:-${FRANKA_DESKAPI_CONFIG:-$CONFIG_DIR/config}}"
CONFIG_HOST=""
CONFIG_USERNAME=""
CONFIG_PASSWORD=""
CONFIG_TOKEN_FILE=""
CONFIG_TIMEOUT=""
CONFIG_CONTROL_TAKE_TIMEOUT=""
CONFIG_INSECURE=""

load_config_file() {
  local file="$1" line key value
  [[ -f "$file" ]] || return 0
  [[ -r "$file" ]] || die "config file is not readable: $file"

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" != "$line" ]] || continue
    case "$key" in
      FRANKA_DESKAPI_HOST|host) CONFIG_HOST="$value" ;;
      FRANKA_DESKAPI_USER|username) CONFIG_USERNAME="$value" ;;
      FRANKA_DESKAPI_PASSWORD|password) CONFIG_PASSWORD="$value" ;;
      FRANKA_DESKAPI_TOKEN_FILE|token_file) CONFIG_TOKEN_FILE="$value" ;;
      FRANKA_DESKAPI_TIMEOUT|timeout) CONFIG_TIMEOUT="$value" ;;
      FRANKA_DESKAPI_CONTROL_TAKE_TIMEOUT|control_take_timeout) CONFIG_CONTROL_TAKE_TIMEOUT="$value" ;;
      FRANKA_DESKAPI_INSECURE|insecure) CONFIG_INSECURE="$value" ;;
    esac
  done < "$file"
}

normalize_bool_setting() {
  local value="$1" name="$2"
  case "$value" in
    1|true|TRUE|yes|YES|on|ON) printf '1' ;;
    0|false|FALSE|no|NO|off|OFF) printf '0' ;;
    *) die "$name must be 1/0, true/false, yes/no, or on/off" ;;
  esac
}

load_config_file "$CONFIG_FILE"

HOST="${FRANKA_DESKAPI_HOST:-${CONFIG_HOST:-$DEFAULT_HOST}}"
USERNAME="${FRANKA_DESKAPI_USER:-${CONFIG_USERNAME:-$DEFAULT_USERNAME}}"
PASSWORD="${FRANKA_DESKAPI_PASSWORD:-${CONFIG_PASSWORD:-$DEFAULT_PASSWORD}}"
CONTROL_TOKEN="${FRANKA_CONTROL_TOKEN:-$DEFAULT_CONTROL_TOKEN}"
TOKEN_FILE="${FRANKA_DESKAPI_TOKEN_FILE:-${CONFIG_TOKEN_FILE:-$CONFIG_DIR/control-token}}"
TOKEN_ID_FILE="${FRANKA_DESKAPI_TOKEN_ID_FILE:-$TOKEN_FILE.id}"
TIMEOUT="${FRANKA_DESKAPI_TIMEOUT:-${CONFIG_TIMEOUT:-$DEFAULT_TIMEOUT}}"
CONTROL_TAKE_TIMEOUT="${FRANKA_DESKAPI_CONTROL_TAKE_TIMEOUT:-${CONFIG_CONTROL_TAKE_TIMEOUT:-$DEFAULT_CONTROL_TAKE_TIMEOUT}}"
INSECURE="${FRANKA_DESKAPI_INSECURE:-${CONFIG_INSECURE:-$DEFAULT_INSECURE}}"
INSECURE="$(normalize_bool_setting "$INSECURE" "FRANKA_DESKAPI_INSECURE")"
CONTROL_TOKEN_FROM_USER=0
[[ -n "${FRANKA_CONTROL_TOKEN:-}" ]] && CONTROL_TOKEN_FROM_USER=1
NO_TOKEN_FILE=0
VERBOSE=0
DRY_RUN=0
JSON_OUTPUT=0

usage() {
  cat <<'EOF'
usage: franka [global-options] <group> <command> [command-options]

Global options:
  --host HOST                 Robot URL or hostname. Env: FRANKA_DESKAPI_HOST
  -u, --username USER         Basic auth username. Env: FRANKA_DESKAPI_USER
  -p, --password PASS         Basic auth password. Env: FRANKA_DESKAPI_PASSWORD
  --control-token TOKEN       SPoC token. Env: FRANKA_CONTROL_TOKEN
  --token-file PATH           Stored SPoC token path
  --no-token-file             Do not read or write the token file
  --timeout SECONDS           curl max time. Env: FRANKA_DESKAPI_TIMEOUT
  --insecure                  Disable TLS certificate verification
  --secure                    Enable TLS certificate verification
  -v, --verbose               Show response headers on errors
  --dry-run                   Print request instead of sending it
  --json                      Print raw JSON where supported
  -h, --help                  Show help

Groups:
  setup           Configure robot host and credentials for this user
  status          Summarize robot, control token, arm, FCI, and safety state
  doctor          Alias for status
  on              Unlock arm if needed, then activate FCI
  free            Enter Desk Programming mode for hand-guiding
  execution       Switch Desk operating mode back to Execution
  lock            Deactivate FCI if needed, then lock arm
  completion      Generate shell completion
  system          System state, software, logs, reboot, shutdown
  control         SPoC control token
  arm             Robot arm
  end-effector    End effector power
  ee              Alias for end-effector
  fci             Franka Control Interface
  config          System configuration
  safety          Safety, self-tests, recovery
  raw             Call any endpoint directly

Examples:
  ./franka setup
  ./franka system state
  ./franka status
  ./franka on
  ./franka free
  ./franka execution
  ./franka lock
  ./franka completion bash
  ./franka control take
  ./franka arm unlock
  ./franka config arm-mounting-set --body @mounting.json
  ./franka raw PATCH /api/configuration --body @configuration.patch.json
EOF
}

