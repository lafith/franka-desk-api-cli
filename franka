require_wait_seconds() {
  local value="$1" name="$2"
  [[ "$value" == "none" ]] && return 0
  [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]] || die "$name must be a positive integer number of seconds or none"
}

wait_for_admin_control_transfer() {
  local auth_token="$1" owner="$2" request_id="${3:-}" wait_timeout="$4"
  local elapsed=0 state current_owner current_token_id requester

  printf 'waiting for control transfer'
  [[ "$wait_timeout" != "none" ]] && printf ' for up to %s seconds' "$wait_timeout"
  printf '\n' >&2

  while :; do
    state="$(admin_request GET /control-token "$auth_token" "" "application/json" "$TIMEOUT" 0)" || return 1
    current_owner="$(printf '%s' "$state" | extract_admin_active_owner || true)"
    current_token_id="$(printf '%s' "$state" | extract_admin_active_token_id || true)"
    requester="$(printf '%s' "$state" | extract_admin_requester || true)"

    if [[ "$current_owner" == "$owner" ]]; then
      if [[ -n "$request_id" && -n "$current_token_id" && "$current_token_id" != "$request_id" ]]; then
        :
      else
        printf 'control transfer confirmed'
        [[ -n "$current_token_id" ]] && printf ' (tokenId=%s)' "$current_token_id"
        printf '\n' >&2
        return 0
      fi
    fi

    if [[ "$wait_timeout" != "none" && "$elapsed" -ge "$wait_timeout" ]]; then
      printf 'timed out waiting for control transfer'
      [[ -n "$current_owner" ]] && printf '; current owner is %s' "$current_owner"
      [[ -n "$requester" ]] && printf '; current requester is %s' "$requester"
      printf '\n' >&2
      return 1
    fi

    sleep 1
    if [[ "$wait_timeout" != "none" ]]; then
      elapsed=$((elapsed + 1))
    fi
  done
}

take_control_token_action() {
  local owner="$1" take_timeout="$2" show_token="${3:-0}"
  local result token token_id body

  if [[ "$take_timeout" == "none" ]]; then
    body="{\"owner\":\"$(json_escape "$owner")\"}"
  else
    require_positive_json_number "$take_timeout" "--wait"
    body="{\"owner\":\"$(json_escape "$owner")\",\"timeout\":$take_timeout}"
  fi

  if ! result="$(api_request POST /api/system/control-token:take "$body" "" "application/octet-stream" "" 0)"; then
    return 1
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '%s\n' "$result"
    return 0
  fi

  token="$(printf '%s' "$result" | extract_token || true)"
  token_id="$(printf '%s' "$result" | extract_token_id || true)"
  if [[ -n "$token" ]]; then
    save_token "$token" "$token_id"
    printf 'saved control token: %s\n' "$TOKEN_FILE" >&2
    print_control_token_result "$token" "$token_id" "control token saved" "$show_token"
  else
    printf 'warning: could not identify token field in response; pass --control-token manually\n' >&2
    return 1
  fi
}

desk_control_request_action() {
  local force="$1" owner wait_timeout show_token auth_token result token token_id path body label
  shift
  owner="$(default_owner)"
  wait_timeout="$TIMEOUT"
  show_token=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --owner) owner="$2"; shift 2 ;;
      --wait)
        [[ $# -ge 2 ]] || die "--wait requires a value"
        wait_timeout="$2"
        shift 2
        ;;
      --show-token) show_token=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  require_wait_seconds "$wait_timeout" "--wait"

  path="/control-token/request"
  label="requesting control"
  if [[ "$force" -eq 1 ]]; then
    path="/control-token/request?force"
    label="enforcing control request"
  fi
  body="{\"requestedBy\":\"$(json_escape "$owner")\"}"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    desk_login
    admin_request POST "$path" "<desk-session-token>" "$body" "application/json" "$TIMEOUT" 0
    return 0
  fi

  printf '%s as %s\n' "$label" "$owner" >&2
  printf 'if the robot asks for confirmation, press the physical confirmation button at the robot\n' >&2
  auth_token="$(desk_login)" || return 1
  result="$(admin_request POST "$path" "$auth_token" "$body" "application/json" "$TIMEOUT" 0)" || return 1
  token="$(printf '%s' "$result" | extract_token || true)"
  token_id="$(printf '%s' "$result" | extract_token_id || true)"
  if [[ -z "$token" ]]; then
    printf '%s\n' "$result"
    printf 'warning: could not identify token field in Desk Admin API response\n' >&2
    return 1
  fi
  printf 'control request submitted'
  [[ -n "$token_id" ]] && printf ' (requestId=%s)' "$token_id"
  printf '\n' >&2

  wait_for_admin_control_transfer "$auth_token" "$owner" "$token_id" "$wait_timeout" || return 1
  save_token "$token" "$token_id"
  printf 'saved control token: %s\n' "$TOKEN_FILE" >&2
  print_control_token_result "$token" "$token_id" "control token saved" "$show_token"
}

