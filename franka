handle_control() {
  local sub="${1:-}"; shift || true
  local result token token_id owner explicit_body take_timeout take_wait_explicit request_transfer show_token state current_owner current_token_id saved_token_id enforce_wait prompt_status
  case "$sub" in
    ""|-h|--help|help) usage_control ;;
    state) api_request_read format_control_state GET /api/system/control-token ;;
    take)
      owner="$(default_owner)"
      explicit_body=""
      take_timeout="$CONTROL_TAKE_TIMEOUT"
      take_wait_explicit=0
      request_transfer=0
      show_token=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --owner) owner="$2"; shift 2 ;;
          --wait) take_timeout="$2"; take_wait_explicit=1; shift 2 ;;
          --request) request_transfer=1; shift ;;
          --show-token) show_token=1; shift ;;
          --body) explicit_body="$(read_body "$2")"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      if [[ -z "$explicit_body" && "$DRY_RUN" -eq 0 ]]; then
        state="$(get_control_state)"
        current_owner="$(printf '%s' "$state" | extract_json_string owner || true)"
        current_token_id="$(printf '%s' "$state" | extract_token_id || true)"
        if [[ -n "$current_owner" ]]; then
          if [[ "$current_owner" == "$owner" ]]; then
            saved_token_id=""
            [[ "$CONTROL_TOKEN_FROM_USER" -eq 0 ]] && saved_token_id="$(load_token_id || true)"
            if [[ -n "$CONTROL_TOKEN" && "$CONTROL_TOKEN_FROM_USER" -eq 1 ]]; then
              print_owner_message "control token already owned by " "$current_owner" "$current_token_id"
              printf 'using provided control token\n' >&2
              print_control_token_result "$CONTROL_TOKEN" "$current_token_id" "control token available from provided token" "$show_token"
              return 0
            fi
            if [[ -n "$CONTROL_TOKEN" && -n "$saved_token_id" && "$saved_token_id" == "$current_token_id" ]]; then
              print_owner_message "control token already owned by " "$current_owner" "$current_token_id"
              printf 'using saved control token: %s\n' "$TOKEN_FILE" >&2
              print_control_token_result "$CONTROL_TOKEN" "$current_token_id" "control token already saved" "$show_token"
              return 0
            fi
	            if [[ -n "$CONTROL_TOKEN" && -z "$saved_token_id" ]]; then
	              [[ -n "$current_token_id" ]] && save_token "$CONTROL_TOKEN" "$current_token_id"
	              print_owner_message "control token already owned by " "$current_owner" "$current_token_id"
	              printf 'using saved control token: %s\n' "$TOKEN_FILE" >&2
	              print_control_token_result "$CONTROL_TOKEN" "$current_token_id" "control token already saved" "$show_token"
	              return 0
            fi
            print_owner_message "control token already owned by " "$current_owner" "$current_token_id"
            if [[ -n "$CONTROL_TOKEN" ]]; then
              printf 'local token exists at %s, but its tokenId is not recorded or does not match\n' "$TOKEN_FILE" >&2
            else
              printf 'no local token is available\n' >&2
            fi
            prompt_refresh_control
            prompt_status=$?
            if [[ "$prompt_status" -eq 0 ]]; then
              enforce_wait="60"
              [[ "$take_wait_explicit" -eq 1 ]] && enforce_wait="$take_timeout"
              printf 'requesting a fresh control token through Desk UI flow (wait=%s)\n' "$enforce_wait" >&2
              if [[ "$show_token" -eq 1 ]]; then
                desk_control_request_action 1 --owner "$owner" --wait "$enforce_wait" --show-token
              else
                desk_control_request_action 1 --owner "$owner" --wait "$enforce_wait"
              fi
              return $?
            fi
            if [[ "$prompt_status" -eq 1 ]]; then
              printf 'fresh token request cancelled\n' >&2
            else
              printf 'interactive prompt unavailable\n' >&2
            fi
            printf 'request fresh token: franka control enforce --wait 60\n' >&2
            printf 'or release control from Desk, then run: franka control take\n' >&2
            return 1
          fi
          print_owner_message "control token already owned by " "$current_owner" "$current_token_id"
          if [[ "$request_transfer" -eq 0 ]]; then
            prompt_enforce_control
            prompt_status=$?
            if [[ "$prompt_status" -eq 0 ]]; then
              enforce_wait="60"
              [[ "$take_wait_explicit" -eq 1 ]] && enforce_wait="$take_timeout"
              printf 'enforcing control transfer through Desk UI flow (wait=%s)\n' "$enforce_wait" >&2
              if [[ "$show_token" -eq 1 ]]; then
                desk_control_request_action 1 --owner "$owner" --wait "$enforce_wait" --show-token
              else
                desk_control_request_action 1 --owner "$owner" --wait "$enforce_wait"
              fi
              return $?
            fi
            if [[ "$prompt_status" -eq 1 ]]; then
              printf 'control transfer cancelled\n' >&2
            else
              printf 'interactive prompt unavailable\n' >&2
            fi
            printf 'request transfer: franka control take --request --wait SECONDS\n' >&2
            printf 'enforce transfer: franka control enforce --wait 60\n' >&2
            return 1
          fi
          printf 'requesting control transfer for owner %s\n' "$owner" >&2
        fi
      fi
	      if [[ -n "$explicit_body" ]]; then
	        BODY="$explicit_body"
	        if ! result="$(api_request POST /api/system/control-token:take "$BODY" "" "application/octet-stream" "" 0)"; then
	          return 1
	        fi
	        if [[ "$DRY_RUN" -eq 1 ]]; then
	          printf '%s\n' "$result"
	        fi
	        [[ "$DRY_RUN" -eq 1 ]] && return 0
	        token="$(printf '%s' "$result" | extract_token || true)"
	        token_id="$(printf '%s' "$result" | extract_token_id || true)"
	        if [[ -n "$token" ]]; then
	          save_token "$token" "$token_id"
	          printf 'saved control token: %s\n' "$TOKEN_FILE" >&2
	          print_control_token_result "$token" "$token_id" "control token saved" "$show_token"
	        else
	          printf 'warning: could not identify token field in response; pass --control-token manually\n' >&2
	        fi
	      else
	        take_control_token_action "$owner" "$take_timeout" "$show_token"
	      fi
	      ;;
    request) desk_control_request_action 0 "$@" ;;
    enforce) desk_control_request_action 1 "$@" ;;
    release)
      if api_request_spoc_friendly "release control token" "control token released" POST /api/system/control-token:release; then
        if [[ "$DRY_RUN" -eq 0 && "$CONTROL_TOKEN_FROM_USER" -eq 0 ]]; then
          delete_token
        fi
      fi
      ;;
    *) die "unknown control command: ${sub:-<missing>}" ;;
  esac
}

