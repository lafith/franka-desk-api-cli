json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

default_owner() {
  hostname 2>/dev/null || printf 'franka-cli'
}

read_body() {
  local value="${1-}"
  [[ -n "$value" ]] || value="{}"
  if [[ "$value" == "-" ]]; then
    cat
  elif [[ "$value" == @* ]]; then
    cat "${value#@}"
  else
    printf '%s' "$value"
  fi
}

extract_token() {
  sed -nE 's/.*"(token|controlToken|control_token|value)"[[:space:]]*:[[:space:]]*"([^"]+)".*/\2/p' | head -n 1
}

extract_token_id() {
  sed -nE 's/.*"(tokenId|id)"[[:space:]]*:[[:space:]]*([0-9]+).*/\2/p' | head -n 1
}

extract_json_string() {
  local key="$1"
  sed -nE "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"([^\"]*)\".*/\\1/p" | head -n 1
}

extract_json_number() {
  local key="$1"
  sed -nE "s/.*\"$key\"[[:space:]]*:[[:space:]]*([0-9]+([.][0-9]+)?).*/\\1/p" | head -n 1
}

extract_json_bool() {
  local key="$1"
  sed -nE "s/.*\"$key\"[[:space:]]*:[[:space:]]*(true|false).*/\\1/p" | head -n 1
}

extract_admin_active_token_id() {
  if command -v jq >/dev/null 2>&1; then
    jq -r '.activeToken.id // empty'
  else
    sed -nE 's/.*"activeToken"[[:space:]]*:[[:space:]]*\{[^}]*"id"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -n 1
  fi
}

extract_admin_active_owner() {
  if command -v jq >/dev/null 2>&1; then
    jq -r '.activeToken.ownedBy // empty'
  else
    sed -nE 's/.*"activeToken"[[:space:]]*:[[:space:]]*\{[^}]*"ownedBy"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -n 1
  fi
}

extract_admin_requester() {
  if command -v jq >/dev/null 2>&1; then
    jq -r '.tokenRequest.requestedBy // empty'
  else
    sed -nE 's/.*"tokenRequest"[[:space:]]*:[[:space:]]*\{[^}]*"requestedBy"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -n 1
  fi
}

require_positive_json_number() {
  [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ && "$1" =~ [1-9] ]] || die "$2 must be a positive JSON number"
}

load_token() {
  if [[ "$NO_TOKEN_FILE" -eq 0 && -z "$CONTROL_TOKEN" && -f "$TOKEN_FILE" ]]; then
    CONTROL_TOKEN="$(tr -d '\r\n' < "$TOKEN_FILE")"
    CONTROL_TOKEN_FROM_USER=0
  fi
  return 0
}

save_token() {
  local token="$1"
  local token_id="${2:-}"
  [[ -z "$token" ]] && return 0
  CONTROL_TOKEN="$token"
  CONTROL_TOKEN_FROM_USER=0
  [[ "$NO_TOKEN_FILE" -eq 1 ]] && return 0
  mkdir -p "$(dirname "$TOKEN_FILE")"
  umask 077
  printf '%s\n' "$token" > "$TOKEN_FILE"
  [[ -n "$token_id" ]] && printf '%s\n' "$token_id" > "$TOKEN_ID_FILE"
  return 0
}

delete_token() {
  [[ "$NO_TOKEN_FILE" -eq 1 ]] && return 0
  rm -f "$TOKEN_FILE" "$TOKEN_ID_FILE"
}

load_token_id() {
  [[ "$NO_TOKEN_FILE" -eq 0 && -f "$TOKEN_ID_FILE" ]] && tr -d '\r\n' < "$TOKEN_ID_FILE"
}

print_token_json() {
  local token="$1" token_id="${2:-}"
  if [[ -n "$token_id" ]]; then
    printf '{"token":"%s","tokenId":%s}\n' "$(json_escape "$token")" "$token_id"
  else
    printf '{"token":"%s"}\n' "$(json_escape "$token")"
  fi
}

print_owner_message() {
  local prefix="$1" owner="$2" token_id="${3:-}"
  if [[ -n "$token_id" ]]; then
    printf '%s%s (tokenId=%s)\n' "$prefix" "$owner" "$token_id" >&2
  else
    printf '%s%s\n' "$prefix" "$owner" >&2
  fi
}

get_control_state() {
  api_request GET /api/system/control-token "" "" "application/octet-stream" "" 0
}

hint_take_control() {
  local owner="$1" token_id="${2:-}" local_owner
  local_owner="$(default_owner)"
  if [[ -n "$owner" ]]; then
    print_owner_message "control token owned by " "$owner" "$token_id"
    if [[ "$owner" == "$local_owner" ]]; then
      printf 'release control from Desk, then run: franka control take\n' >&2
    else
      printf 'request control with: franka control take --request --wait SECONDS\n' >&2
      printf 'enforce control with: franka control enforce --wait 60\n' >&2
    fi
  else
    printf 'control token is available; run: franka control take\n' >&2
  fi
}

ensure_control_token_for_action() {
  local action="$1" state current_owner current_token_id saved_token_id
  [[ "$DRY_RUN" -eq 1 ]] && return 0

  state="$(get_control_state)"
  current_owner="$(printf '%s' "$state" | extract_json_string owner || true)"
  current_token_id="$(printf '%s' "$state" | extract_token_id || true)"
  saved_token_id=""
  [[ "$CONTROL_TOKEN_FROM_USER" -eq 0 ]] && saved_token_id="$(load_token_id || true)"

  if [[ -z "$CONTROL_TOKEN" ]]; then
    printf 'cannot %s: no local control token\n' "$action" >&2
    hint_take_control "$current_owner" "$current_token_id"
    return 1
  fi

  if [[ -n "$saved_token_id" && -n "$current_token_id" && "$saved_token_id" != "$current_token_id" ]]; then
    printf 'cannot %s: saved control token is stale (saved tokenId=%s, active tokenId=%s)\n' "$action" "$saved_token_id" "$current_token_id" >&2
    hint_take_control "$current_owner" "$current_token_id"
    return 1
  fi

  return 0
}

print_friendly_result() {
  local result="$1" message="$2"
  if [[ -z "$result" || "$result" =~ ^20[0-9]$ ]]; then
    printf '%s\n' "$message"
  else
    printf '%s\n' "$result"
  fi
}

print_control_token_result() {
  local token="$1" token_id="${2:-}" prefix="$3" show_token="${4:-0}"
  if [[ "$JSON_OUTPUT" -eq 1 || "$show_token" -eq 1 ]]; then
    print_token_json "$token" "$token_id"
  elif [[ -n "$token_id" ]]; then
    printf '%s (tokenId=%s)\n' "$prefix" "$token_id"
  else
    printf '%s\n' "$prefix"
  fi
}

prompt_enforce_control() {
  local answer
  [[ -t 0 && -t 2 ]] || return 2
  printf 'another user owns the control token. Enforce control transfer? [y/N] ' >&2
  IFS= read -r answer || return 1
  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

prompt_refresh_control() {
  local answer
  [[ -t 0 && -t 2 ]] || return 2
  printf 'control is already owned by this owner, but the local token is missing or stale. Enforce a fresh token? [y/N] ' >&2
  IFS= read -r answer || return 1
  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

print_error_hint() {
  local status="$1" path="$2" body_file="$3"

  if [[ "$status" == "401" ]]; then
    printf 'hint: authentication failed; rerun franka setup and check the Desk/API username and password\n' >&2
    return 0
  fi

  if [[ "$status" == "423" ]]; then
    printf 'hint: this endpoint requires SPoC; run: franka control take\n' >&2
    return 0
  fi

  if grep -q '"BrakesClosed"' "$body_file"; then
    printf 'hint: brakes are closed; run: franka arm unlock\n' >&2
  fi
  if grep -q '"WrongOperatingMode"' "$body_file"; then
    printf 'hint: switch to Execution mode before retrying\n' >&2
  fi
  if grep -q '"EmergencyStopPressed"' "$body_file"; then
    printf 'hint: release the emergency stop, then retry\n' >&2
  fi
  if grep -q '"RecoverableErrorActive"' "$body_file"; then
    printf 'hint: inspect recovery state with: franka safety recovery\n' >&2
  fi
  if grep -q '"SafetySettingsUnvalidated"' "$body_file"; then
    printf 'hint: validate safety settings in Watchman before retrying\n' >&2
  fi
  if grep -q '"FeatureNotInstalled"' "$body_file"; then
    printf 'hint: required robot feature is not installed\n' >&2
  fi
  if grep -q '"Timeout"' "$body_file" && [[ "$path" == "/api/system/control-token:take" ]]; then
    printf 'hint: control was not granted before the wait timeout; check Desk or retry with --wait SECONDS\n' >&2
  fi
  return 0
}

confirm_destructive_action() {
  local action="$1" yes="$2" answer
  [[ "$DRY_RUN" -eq 1 ]] && return 0
  [[ "$yes" -eq 1 ]] && return 0
  if [[ ! -t 0 ]]; then
    die "refusing to $action without confirmation; pass --yes"
  fi
  printf 'Type "%s" to confirm: ' "$action" >&2
  read -r answer
  [[ "$answer" == "$action" ]] || die "$action cancelled"
}

parse_yes_option() {
  YES=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
}

mask_secret_state() {
  if [[ -n "$1" ]]; then
    printf 'set'
  else
    printf 'missing'
  fi
}

print_setup_summary_values() {
  local config_file="$1" host="$2" username="$3" password="$4" token_file="$5" timeout="$6" control_take_timeout="$7" insecure="$8"
  printf 'config: %s\n' "$config_file"
  printf 'host: %s\n' "${host:-not set}"
  printf 'username: %s\n' "${username:-not set}"
  printf 'password: %s\n' "$(mask_secret_state "$password")"
  printf 'token file: %s\n' "${token_file:-not set}"
  printf 'timeout: %s\n' "${timeout:-not set}"
  printf 'control take timeout: %s\n' "${control_take_timeout:-not set}"
  if [[ "$insecure" -eq 1 ]]; then
    printf 'TLS verification: disabled\n'
  else
    printf 'TLS verification: enabled\n'
  fi
}

print_setup_summary() {
  if [[ -f "$CONFIG_FILE" ]]; then
    printf 'setup config exists\n'
  else
    printf 'setup config is missing; run: franka setup\n'
  fi
  print_setup_summary_values "$CONFIG_FILE" "$HOST" "$USERNAME" "$PASSWORD" "$TOKEN_FILE" "$TIMEOUT" "$CONTROL_TAKE_TIMEOUT" "$INSECURE"
}

prompt_value() {
  local label="$1" current="$2" value
  if [[ -n "$current" ]]; then
    printf '%s [%s]: ' "$label" "$current" >&2
  else
    printf '%s: ' "$label" >&2
  fi
  IFS= read -r value
  if [[ -n "$value" ]]; then
    printf '%s' "$value"
  else
    printf '%s' "$current"
  fi
}

prompt_secret_value() {
  local label="$1" current="$2" value
  if [[ -n "$current" ]]; then
    printf '%s [saved, Enter to keep]: ' "$label" >&2
  else
    printf '%s: ' "$label" >&2
  fi
  IFS= read -r -s value
  printf '\n' >&2
  if [[ -n "$value" ]]; then
    printf '%s' "$value"
  else
    printf '%s' "$current"
  fi
}

prompt_tls_verification() {
  local current="$1" answer
  while true; do
    if [[ "$current" -eq 1 ]]; then
      printf 'Disable TLS certificate verification? [Y/n]: ' >&2
    else
      printf 'Disable TLS certificate verification? [y/N]: ' >&2
    fi
    IFS= read -r answer
    case "$answer" in
      "") printf '%s' "$current"; return 0 ;;
      y|Y|yes|YES) printf '1'; return 0 ;;
      n|N|no|NO) printf '0'; return 0 ;;
      *) printf 'Please answer yes or no.\n' >&2 ;;
    esac
  done
}

validate_config_value() {
  local name="$1" value="$2"
  case "$value" in
    *$'\n'*|*$'\r'*) die "$name cannot contain newlines" ;;
  esac
}

write_setup_config() {
  local host="$1" username="$2" password="$3" token_file="$4" timeout="$5" control_take_timeout="$6" insecure="$7"
  local dir tmp

  validate_config_value "host" "$host"
  validate_config_value "username" "$username"
  validate_config_value "password" "$password"
  validate_config_value "token file" "$token_file"
  require_positive_json_number "$timeout" "--timeout"
  require_positive_json_number "$control_take_timeout" "--control-take-timeout"
  insecure="$(normalize_bool_setting "$insecure" "FRANKA_DESKAPI_INSECURE")"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf 'would write setup config: %s\n' "$CONFIG_FILE"
    print_setup_summary_values "$CONFIG_FILE" "$host" "$username" "$password" "$token_file" "$timeout" "$control_take_timeout" "$insecure"
    return 0
  fi

  dir="$(dirname "$CONFIG_FILE")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/config.XXXXXX")"
  trap 'rm -f "${tmp:-}"; trap - RETURN' RETURN
  {
    printf '# Franka Desk API CLI config\n'
    printf '# Created by franka setup. Keep this file private.\n'
    printf 'FRANKA_DESKAPI_HOST=%s\n' "$host"
    printf 'FRANKA_DESKAPI_USER=%s\n' "$username"
    printf 'FRANKA_DESKAPI_PASSWORD=%s\n' "$password"
    printf 'FRANKA_DESKAPI_TOKEN_FILE=%s\n' "$token_file"
    printf 'FRANKA_DESKAPI_TIMEOUT=%s\n' "$timeout"
    printf 'FRANKA_DESKAPI_CONTROL_TAKE_TIMEOUT=%s\n' "$control_take_timeout"
    printf 'FRANKA_DESKAPI_INSECURE=%s\n' "$insecure"
  } > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$CONFIG_FILE"
  trap - RETURN

  printf 'saved setup: %s\n' "$CONFIG_FILE"
  print_setup_summary_values "$CONFIG_FILE" "$host" "$username" "$password" "$token_file" "$timeout" "$control_take_timeout" "$insecure"
}

handle_setup() {
  local host="$HOST" username="$USERNAME" password="$PASSWORD" token_file="$TOKEN_FILE" timeout="$TIMEOUT"
  local control_take_timeout="$CONTROL_TAKE_TIMEOUT" insecure="$INSECURE"
  local show=0 reset=0 set_any=0 full_prompt=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; set_any=1; shift 2 ;;
      -u|--username) username="$2"; set_any=1; shift 2 ;;
      -p|--password) password="$2"; set_any=1; shift 2 ;;
      --token-file) token_file="$2"; set_any=1; shift 2 ;;
      --timeout) timeout="$2"; set_any=1; shift 2 ;;
      --control-take-timeout) control_take_timeout="$2"; set_any=1; shift 2 ;;
      --insecure) insecure=1; set_any=1; shift ;;
      --secure) insecure=0; set_any=1; shift ;;
      --show) show=1; shift ;;
      --reset) reset=1; shift ;;
      -h|--help|help) usage_setup; return 0 ;;
      *) die "unknown setup option: $1" ;;
    esac
  done

  [[ "$show" -eq 0 || "$reset" -eq 0 ]] || die "use either --show or --reset, not both"

  if [[ "$show" -eq 1 ]]; then
    print_setup_summary
    return 0
  fi

  if [[ "$reset" -eq 1 ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      printf 'would remove setup config: %s\n' "$CONFIG_FILE"
    else
      rm -f "$CONFIG_FILE"
      printf 'removed setup config: %s\n' "$CONFIG_FILE"
    fi
    printf 'control token file was not removed: %s\n' "$TOKEN_FILE"
    return 0
  fi

  if [[ "$set_any" -eq 0 ]]; then
    full_prompt=1
    [[ -t 0 ]] || die "interactive setup requires a terminal; pass setup options instead"
  fi

  if [[ -t 0 && ( "$full_prompt" -eq 1 || -z "$host" || -z "$username" || -z "$password" ) ]]; then
    printf 'Configuring Desk API for this user.\n' >&2
    printf 'Config file: %s\n' "$CONFIG_FILE" >&2
    host="$(prompt_value "Robot host or URL" "$host")"
    username="$(prompt_value "Basic auth username" "$username")"
    password="$(prompt_secret_value "Basic auth password" "$password")"
    if [[ "$full_prompt" -eq 1 ]]; then
      token_file="$(prompt_value "Control token file" "$token_file")"
      timeout="$(prompt_value "Request timeout seconds" "$timeout")"
      control_take_timeout="$(prompt_value "Control take wait seconds" "$control_take_timeout")"
      insecure="$(prompt_tls_verification "$insecure")"
    fi
  fi

  [[ -n "$host" ]] || die "host is required"
  [[ -n "$username" ]] || die "username is required"
  [[ -n "$password" ]] || die "password is required"
  [[ -n "$token_file" ]] || die "token file is required"

  write_setup_config "$host" "$username" "$password" "$token_file" "$timeout" "$control_take_timeout" "$insecure"
}

normalize_host() {
  [[ -n "$HOST" ]] || die "host is required; run: franka setup"
  [[ -n "$USERNAME" ]] || die "username is required; run: franka setup"
  [[ -n "$PASSWORD" ]] || die "password is required; run: franka setup"
  case "$HOST" in
    http://*|https://*) ;;
    *) HOST="https://$HOST" ;;
  esac
  HOST="${HOST%/}"
}

curl_common_args() {
  local include_control_token="${1:-1}"
  CURL_ARGS=(-sS --connect-timeout "$TIMEOUT")
  [[ "$INSECURE" -eq 1 ]] && CURL_ARGS+=(-k)
  [[ -n "$USERNAME" && -n "$PASSWORD" ]] && CURL_ARGS+=(-u "$USERNAME:$PASSWORD")
  [[ "$include_control_token" -eq 1 && -n "$CONTROL_TOKEN" ]] && CURL_ARGS+=(-H "X-Control-Token: $CONTROL_TOKEN")
  return 0
}

desk_password_hash() {
  command -v openssl >/dev/null 2>&1 || die "openssl is required for Desk session login"
  command -v od >/dev/null 2>&1 || die "od is required for Desk session login"
  command -v base64 >/dev/null 2>&1 || die "base64 is required for Desk session login"
  printf '%s' "${PASSWORD}#${USERNAME}@franka" |
    openssl dgst -sha256 -binary |
    od -An -t u1 -v |
    tr -s '[:space:]' ',' |
    sed 's/^,//;s/,$//' |
    base64 |
    tr -d '\r\n'
}

desk_login() {
  local password_hash body body_file status url
  normalize_host
  url="$HOST/admin/api/login"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf 'METHOD POST\n'
    printf 'URL %s\n' "$url"
    [[ "$INSECURE" -eq 1 ]] && printf 'TLS verify disabled\n'
    [[ "$INSECURE" -eq 0 ]] && printf 'TLS verify enabled\n'
    printf 'AUTH Desk username=%s password=<redacted>\n' "$USERNAME"
    printf 'HEADER Content-Type: application/json\n'
    printf 'BODY {"login":"%s","password":"<redacted>"}\n' "$(json_escape "$USERNAME")"
    printf '%s\n' "<desk-session-token>"
    return 0
  fi

  password_hash="$(desk_password_hash)"
  body="{\"login\":\"$(json_escape "$USERNAME")\",\"password\":\"$(json_escape "$password_hash")\"}"
  body_file="$(mktemp)"
  trap 'rm -f "${body_file:-}"; trap - RETURN' RETURN

  CURL_ARGS=(-sS --connect-timeout "$TIMEOUT" -X POST --max-time "$TIMEOUT" -o "$body_file" -w '%{http_code}' -H 'Content-Type: application/json' --data-binary "$body")
  [[ "$INSECURE" -eq 1 ]] && CURL_ARGS+=(-k)

  status="$(curl "${CURL_ARGS[@]}" "$url")" || {
    rm -f "$body_file"
    die "Desk login request failed"
  }

  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    printf 'HTTP %s\n' "$status" >&2
    cat "$body_file" >&2
    printf '\n' >&2
    if [[ "$status" == "401" ]]; then
      printf 'hint: Desk login failed; rerun franka setup and check the Desk/API username and password\n' >&2
    fi
    return 1
  fi

  tr -d '\r\n' < "$body_file"
}

desk_request() {
  local method="$1" path="$2" auth_token="$3" body="${4-}" content_type="${5:-application/json}"
  local body_file status url
  normalize_host
  url="$HOST/desk/api$path"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf 'METHOD %s\n' "$method"
    printf 'URL %s\n' "$url"
    [[ "$INSECURE" -eq 1 ]] && printf 'TLS verify disabled\n'
    [[ "$INSECURE" -eq 0 ]] && printf 'TLS verify enabled\n'
    printf 'COOKIE authorization=<redacted>\n'
    [[ -n "$CONTROL_TOKEN" ]] && printf 'HEADER X-Control-Token: <redacted>\n'
    if [[ -n "$body" ]]; then
      printf 'HEADER Content-Type: %s\n' "$content_type"
      printf 'BODY %s\n' "$body"
    fi
    return 0
  fi

  body_file="$(mktemp)"
  trap 'rm -f "${body_file:-}"; trap - RETURN' RETURN

  CURL_ARGS=(-sS --connect-timeout "$TIMEOUT" -X "$method" --max-time "$TIMEOUT" -o "$body_file" -w '%{http_code}' -H "Cookie: authorization=$auth_token")
  [[ "$INSECURE" -eq 1 ]] && CURL_ARGS+=(-k)
  [[ -n "$CONTROL_TOKEN" ]] && CURL_ARGS+=(-H "X-Control-Token: $CONTROL_TOKEN")
  if [[ -n "$body" ]]; then
    CURL_ARGS+=(-H "Content-Type: $content_type" --data-binary "$body")
  fi

  status="$(curl "${CURL_ARGS[@]}" "$url")" || {
    rm -f "$body_file"
    die "Desk private API request failed"
  }

  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    printf 'HTTP %s\n' "$status" >&2
    cat "$body_file" >&2
    printf '\n' >&2
    return 1
  fi

  if [[ -s "$body_file" ]]; then
    cat "$body_file"
    printf '\n'
  else
    printf '%s\n' "$status"
  fi
}

admin_request() {
  local method="$1" path="$2" auth_token="$3" body="${4-}" content_type="${5:-application/json}" request_timeout="${6:-$TIMEOUT}" include_control_token="${7:-1}"
  local body_file status url
  normalize_host
  url="$HOST/admin/api$path"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf 'METHOD %s\n' "$method"
    printf 'URL %s\n' "$url"
    [[ "$INSECURE" -eq 1 ]] && printf 'TLS verify disabled\n'
    [[ "$INSECURE" -eq 0 ]] && printf 'TLS verify enabled\n'
    printf 'COOKIE authorization=<redacted>\n'
    [[ "$include_control_token" -eq 1 && -n "$CONTROL_TOKEN" ]] && printf 'HEADER X-Control-Token: <redacted>\n'
    if [[ -n "$body" ]]; then
      printf 'HEADER Content-Type: %s\n' "$content_type"
      printf 'BODY %s\n' "$body"
    fi
    return 0
  fi

  body_file="$(mktemp)"
  trap 'rm -f "${body_file:-}"; trap - RETURN' RETURN

  CURL_ARGS=(-sS --connect-timeout "$TIMEOUT" -X "$method" -o "$body_file" -w '%{http_code}' -H "Cookie: authorization=$auth_token")
  [[ "$request_timeout" != "none" ]] && CURL_ARGS+=(--max-time "$request_timeout")
  [[ "$INSECURE" -eq 1 ]] && CURL_ARGS+=(-k)
  [[ "$include_control_token" -eq 1 && -n "$CONTROL_TOKEN" ]] && CURL_ARGS+=(-H "X-Control-Token: $CONTROL_TOKEN")
  if [[ -n "$body" ]]; then
    CURL_ARGS+=(-H "Content-Type: $content_type" --data-binary "$body")
  fi

  status="$(curl "${CURL_ARGS[@]}" "$url")" || {
    rm -f "$body_file"
    die "Desk Admin API request failed"
  }

  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    printf 'HTTP %s\n' "$status" >&2
    cat "$body_file" >&2
    printf '\n' >&2
    return 1
  fi

  if [[ -s "$body_file" ]]; then
    cat "$body_file"
    printf '\n'
  else
    printf '%s\n' "$status"
  fi
}

current_operating_mode() {
  local state
  state="$(api_request GET /api/system/operating-mode)" || return 1
  printf '%s' "$state" | extract_json_string status || true
}

wait_operating_mode() {
  local desired="$1" timeout="${2:-10}" mode i
  for ((i=0; i<=timeout; i++)); do
    mode="$(current_operating_mode || true)"
    if [[ "$mode" == "$desired" ]]; then
      printf 'operating mode: %s\n' "$mode"
      return 0
    fi
    [[ "$i" -lt "$timeout" ]] && sleep 1
  done

  printf 'timed out waiting for operating mode %s' "$desired" >&2
  [[ -n "$mode" ]] && printf ' (current: %s)' "$mode" >&2
  printf '\n' >&2
  return 1
}

desk_switch_operating_mode() {
  local desk_mode="$1" expected auth_token mode
  case "$desk_mode" in
    programming) expected="Programming" ;;
    execution) expected="Execution" ;;
    *) die "unknown Desk operating mode: $desk_mode" ;;
  esac
  ensure_control_token_for_action "switch Desk operating mode to $desk_mode" || return 1

  if [[ "$DRY_RUN" -eq 1 ]]; then
    desk_login
    auth_token="<desk-session-token>"
    desk_request POST "/operating-mode/$desk_mode" "$auth_token"
    api_request GET /api/system/operating-mode
    return 0
  fi

  mode="$(current_operating_mode || true)"
  if [[ "$mode" == "$expected" ]]; then
    printf 'operating mode already %s\n' "$mode"
    return 0
  fi

  auth_token="$(desk_login)" || return 1
  desk_request POST "/operating-mode/$desk_mode" "$auth_token" >/dev/null || return 1
  wait_operating_mode "$expected" 10
}

desk_guiding_mode_label() {
  case "$1" in
    0) printf 'translation' ;;
    1) printf 'rotation' ;;
    2) printf 'free' ;;
    3) printf 'user' ;;
    *) printf 'unknown' ;;
  esac
}

desk_set_guiding_mode() {
  local mode="$1" auth_token result current_mode label
  case "$mode" in
    translation|rotation|free|user) ;;
    *) die "unknown guiding mode: $mode" ;;
  esac
  ensure_control_token_for_action "set guiding mode" || return 1

  if [[ "$DRY_RUN" -eq 1 ]]; then
    desk_login
    auth_token="<desk-session-token>"
    desk_request PUT /robot/guiding/mode "$auth_token" "mode=%22${mode}%22" "application/x-www-form-urlencoded"
    desk_request GET /robot/guiding/mode "$auth_token"
    return 0
  fi

  auth_token="$(desk_login)" || return 1
  desk_request PUT /robot/guiding/mode "$auth_token" "mode=%22${mode}%22" "application/x-www-form-urlencoded" >/dev/null || return 1
  result="$(desk_request GET /robot/guiding/mode "$auth_token")" || return 1
  current_mode="$(printf '%s' "$result" | extract_json_number currentMode || true)"
  label="$(desk_guiding_mode_label "$current_mode")"
  if [[ "$label" == "$mode" ]]; then
    printf 'guiding mode: %s\n' "$label"
  else
    printf 'guiding mode requested: %s; reported: %s\n' "$mode" "$label"
  fi
}

api_request() {
  local method="$1"
  local path="$2"
  local body="${3-}"
  local upload_file="${4-}"
  local content_type="${5:-application/octet-stream}"
  local output="${6-}"
  local include_control_token="${7:-1}"
  local body_file header_file status url

  normalize_host
  url="$HOST$path"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf 'METHOD %s\n' "$method"
    printf 'URL %s\n' "$url"
    [[ "$INSECURE" -eq 1 ]] && printf 'TLS verify disabled\n'
    [[ "$INSECURE" -eq 0 ]] && printf 'TLS verify enabled\n'
    [[ -n "$USERNAME" && -n "$PASSWORD" ]] && printf 'AUTH Basic username=%s password=<redacted>\n' "$USERNAME"
    [[ "$include_control_token" -eq 1 && -n "$CONTROL_TOKEN" ]] && printf 'HEADER X-Control-Token: <redacted>\n'
    if [[ -n "$upload_file" ]]; then
      printf 'HEADER Content-Type: %s\n' "$content_type"
      printf 'FILE %s\n' "$upload_file"
    elif [[ -n "$body" ]]; then
      printf 'HEADER Content-Type: application/json\n'
      printf 'BODY '
      printf '%s' "$body"
      printf '\n'
    fi
    return 0
  fi

  body_file="$(mktemp)"
  header_file="$(mktemp)"
  trap 'rm -f "${body_file:-}" "${header_file:-}"; trap - RETURN' RETURN

  curl_common_args "$include_control_token"
  CURL_ARGS+=(-X "$method" --max-time "$TIMEOUT" -D "$header_file" -o "$body_file" -w '%{http_code}' -H 'Accept: application/json')

  if [[ -n "$upload_file" ]]; then
    CURL_ARGS+=(-H "Content-Type: $content_type" --data-binary "@$upload_file")
  elif [[ -n "$body" ]]; then
    CURL_ARGS+=(-H 'Content-Type: application/json' --data-binary "$body")
  fi

  status="$(curl "${CURL_ARGS[@]}" "$url")" || {
    rm -f "$body_file" "$header_file"
    die "curl request failed"
  }

  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    printf 'HTTP %s\n' "$status" >&2
    [[ "$VERBOSE" -eq 1 ]] && cat "$header_file" >&2
    cat "$body_file" >&2
    printf '\n' >&2
    print_error_hint "$status" "$path" "$body_file"
    return 1
  fi

  if [[ -n "$output" ]]; then
    cp "$body_file" "$output"
  elif [[ -s "$body_file" ]]; then
    cat "$body_file"
    printf '\n'
  else
    printf '%s\n' "$status"
  fi
}

api_sse() {
  local path="$1"
  normalize_host
  curl_common_args
  CURL_ARGS+=(-N -H 'Accept: text/event-stream')
  curl "${CURL_ARGS[@]}" "$HOST$path"
}

api_request_friendly() {
  local message="$1" result
  shift
  if ! result="$(api_request "$@")"; then
    return 1
  fi
  print_friendly_result "$result" "$message"
}

api_request_spoc_friendly() {
  local action="$1" message="$2"
  shift 2
  ensure_control_token_for_action "$action" || return 1
  api_request_friendly "$message" "$@"
}

api_request_read() {
  local formatter="$1" result
  shift
  if ! result="$(api_request "$@")"; then
    return 1
  fi
  if [[ "$JSON_OUTPUT" -eq 1 || "$DRY_RUN" -eq 1 ]]; then
    printf '%s\n' "$result"
  else
    "$formatter" "$result"
  fi
}

format_system_state() {
  local json="$1" status mode cloud reason serial
  status="$(printf '%s' "$json" | extract_json_string status || true)"
  mode="$(printf '%s' "$json" | sed -nE 's/.*"operatingMode"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -n 1)"
  cloud="$(printf '%s' "$json" | sed -nE 's/.*"connection"[[:space:]]*:[[:space:]]*\{[^}]*"status"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -n 1)"
  reason="$(printf '%s' "$json" | extract_json_string offlineReason || true)"
  serial="$(printf '%s' "$json" | extract_json_string controlSerialNumber || true)"
  printf 'system: %s\n' "${status:-unknown}"
  [[ -n "$mode" ]] && printf 'operating mode: %s\n' "$mode"
  if [[ -n "$cloud" && -n "$reason" ]]; then
    printf 'cloud: %s (%s)\n' "$cloud" "$reason"
  elif [[ -n "$cloud" ]]; then
    printf 'cloud: %s\n' "$cloud"
  fi
  [[ -n "$serial" ]] && printf 'control serial: %s\n' "$serial"
  return 0
}

format_simple_status() {
  local label="$1" json="$2" status
  status="$(printf '%s' "$json" | extract_json_string status || true)"
  printf '%s: %s\n' "$label" "${status:-unknown}"
  return 0
}

format_operating_mode() {
  format_simple_status "operating mode" "$1"
}

format_control_state() {
  local json="$1" owner requester token_id saved_token_id local_state
  owner="$(printf '%s' "$json" | extract_json_string owner || true)"
  requester="$(printf '%s' "$json" | extract_json_string requester || true)"
  token_id="$(printf '%s' "$json" | extract_token_id || true)"
  saved_token_id="$(load_token_id || true)"

  if [[ -n "$owner" ]]; then
    if [[ -n "$token_id" ]]; then
      printf 'control token: owned by %s (tokenId=%s)\n' "$owner" "$token_id"
    else
      printf 'control token: owned by %s\n' "$owner"
    fi
  else
    printf 'control token: available\n'
  fi

  if [[ -n "$requester" ]]; then
    printf 'requester: %s\n' "$requester"
  fi

  local_state="missing"
  if [[ -n "$CONTROL_TOKEN" ]]; then
    local_state="present"
    if [[ -n "$saved_token_id" && -n "$token_id" ]]; then
      if [[ "$saved_token_id" == "$token_id" ]]; then
        local_state="valid"
      else
        local_state="stale (saved tokenId=$saved_token_id)"
      fi
    fi
  fi
  printf 'local token: %s\n' "$local_state"
  return 0
}

arm_brake_summary() {
  local json="$1"
  if [[ "$json" == *'"brakeStatus":"Locked"'* && "$json" != *'"brakeStatus":"Unlocked"'* ]]; then
    printf 'locked'
  elif [[ "$json" == *'"brakeStatus":"Unlocked"'* && "$json" != *'"brakeStatus":"Locked"'* ]]; then
    printf 'unlocked'
  elif [[ "$json" == *'"brakeStatus"'* ]]; then
    printf 'mixed'
  else
    printf 'unknown'
  fi
}

format_arm_info() {
  local json="$1" status arm_type
  status="$(printf '%s' "$json" | extract_json_string status || true)"
  arm_type="$(printf '%s' "$json" | extract_json_string armType || true)"
  if [[ -n "$arm_type" ]]; then
    printf 'arm: %s (%s)\n' "${status:-unknown}" "$arm_type"
  else
    printf 'arm: %s\n' "${status:-unknown}"
  fi
  return 0
}

format_arm_joints() {
  local json="$1" summary
  summary="$(arm_brake_summary "$json")"
  printf 'arm joints: %s\n' "$summary"
  if [[ "$summary" == "mixed" ]]; then
    printf '%s' "$json" |
      sed -E 's/\},[[:space:]]*\{/\}\n\{/g' |
      sed -nE 's/.*"brakeStatus"[[:space:]]*:[[:space:]]*"([^"]+)".*"joint"[[:space:]]*:[[:space:]]*([0-9]+).*/joint \2: \1/p'
  fi
  return 0
}

format_arm_warnings() {
  local json="$1" close_to_singularity
  close_to_singularity="$(printf '%s' "$json" | extract_json_bool closeToSingularity || true)"
  if [[ "$close_to_singularity" == "true" ]]; then
    printf 'arm warnings: close to singularity\n'
  elif [[ "$json" == "{}" || "$close_to_singularity" == "false" ]]; then
    printf 'arm warnings: none\n'
  else
    printf 'arm warnings available; use --json for details\n'
  fi
  return 0
}

format_end_effector_power() {
  format_simple_status "end effector power" "$1"
}

format_fci_state() {
  format_simple_status "FCI" "$1"
}

format_self_tests() {
  local json="$1" status remaining hours minutes
  status="$(printf '%s' "$json" | extract_json_string status || true)"
  remaining="$(printf '%s' "$json" | extract_json_number remaining || true)"
  printf 'self-tests: %s\n' "${status:-unknown}"
  if [[ -n "$remaining" && "$remaining" =~ ^[0-9]+$ ]]; then
    hours=$((remaining / 3600))
    minutes=$(((remaining % 3600) / 60))
    printf 'self-tests remaining: %sh %sm\n' "$hours" "$minutes"
  fi
  return 0
}

format_recovery() {
  local json="$1" type
  if [[ "$json" == "{}" ]]; then
    printf 'safety recovery: none pending\n'
    return 0
  fi
  type="$(printf '%s' "$json" | extract_json_string type || true)"
  if [[ -n "$type" ]]; then
    printf 'safety recovery: %s pending\n' "$type"
  else
    printf 'safety recovery pending; use --json for details\n'
  fi
}

format_updates() {
  local json="$1" factory_reset
  factory_reset="$(printf '%s' "$json" | extract_json_bool factoryResetRequired || true)"
  if [[ "$json" == *'"add":[]'* && "$json" == *'"remove":[]'* && "$json" == *'"update":[]'* ]]; then
    printf 'software updates: none pending\n'
  else
    printf 'software updates pending; use --json for details\n'
  fi
  [[ "$factory_reset" == "true" ]] && printf 'software updates: factory reset required\n'
  return 0
}

format_software() {
  local json="$1" os_version features
  os_version="$(printf '%s' "$json" | extract_json_string osVersion || true)"
  features="$(printf '%s' "$json" | grep -o '"featureName":"[^"]*"' | sed 's/"featureName":"//; s/"//' | paste -sd, - | sed 's/,/, /g' || true)"
  [[ -n "$os_version" ]] && printf 'software OS: %s\n' "$os_version"
  [[ -n "$features" ]] && printf 'features: %s\n' "$features"
  format_updates "$json"
  return 0
}

format_arm_mounting() {
  local json="$1" pitch roll yaw
  pitch="$(printf '%s' "$json" | extract_json_number pitch || true)"
  roll="$(printf '%s' "$json" | extract_json_number roll || true)"
  yaw="$(printf '%s' "$json" | extract_json_number yaw || true)"
  printf 'arm mounting orientation: roll=%s pitch=%s yaw=%s\n' "${roll:-unknown}" "${pitch:-unknown}" "${yaw:-unknown}"
  return 0
}

format_config_summary() {
  printf 'configuration retrieved; rerun with --json to print the full configuration\n'
}

handle_status() {
  local system_state control_state arm_info arm_joints ee_power fci_state self_tests recovery
  system_state="$(api_request GET /api/system)"
  control_state="$(get_control_state)"
  arm_info="$(api_request GET /api/arm)"
  arm_joints="$(api_request GET /api/arm/joints)"
  ee_power="$(api_request GET /api/end-effector/power)"
  fci_state="$(api_request GET /api/fci)"
  self_tests="$(api_request GET /api/safety/self-tests)"
  recovery="$(api_request GET /api/safety/recovery)"

  if [[ "$JSON_OUTPUT" -eq 1 ]]; then
    printf '{"system":%s,"control":%s,"arm":%s,"joints":%s,"endEffectorPower":%s,"fci":%s,"selfTests":%s,"recovery":%s}\n' \
      "$system_state" "$control_state" "$arm_info" "$arm_joints" "$ee_power" "$fci_state" "$self_tests" "$recovery"
    return 0
  fi

  format_system_state "$system_state"
  format_control_state "$control_state"
