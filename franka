  fi
  [[ "$lock_status" -eq 0 ]] || return "$lock_status"
  return "$fci_status"
}

parse_body_option() {
  local default="${1-}"
  [[ -n "$default" ]] || default="{}"
  shift || true
  BODY="$default"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --body) BODY="$(read_body "$2")"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
}

parse_file_or_body_options() {
  BODY=""
  FILE=""
  CONTENT_TYPE="application/octet-stream"
  OUTPUT=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --body) BODY="$(read_body "$2")"; shift 2 ;;
      --file) FILE="$2"; shift 2 ;;
      --content-type) CONTENT_TYPE="$2"; shift 2 ;;
      --output) OUTPUT="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ -n "$BODY" && -n "$FILE" ]] && die "use either --body or --file, not both"
  return 0
}

parse_output_option() {
  OUTPUT=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
