    joint-motion-start)
      parse_body_option "{}" "$@"
      api_request_spoc_friendly "start joint recovery motion" "joint recovery motion started" POST /api/safety/recovery/joint-motion:start "$BODY"
      ;;
    joint-motion-continue)
      token=""
      token_key="continuationToken"
      body=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --body) body="$(read_body "$2")"; shift 2 ;;
          --token) token="$2"; shift 2 ;;
          --token-key) token_key="$2"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      [[ -n "$body" && -n "$token" ]] && die "use either --body or --token, not both"
      [[ -n "$body" || -n "$token" ]] || die "provide --body or --token"
      if [[ -z "$body" ]]; then
        body="{\"$(json_escape "$token_key")\":\"$(json_escape "$token")\"}"
      fi
      api_request_spoc_friendly "continue joint recovery motion" "joint recovery motion completed" POST /api/safety/recovery/joint-motion:continue "$body"
      ;;
    joint-motion-stop) api_request_spoc_friendly "stop joint recovery motion" "joint recovery motion stopped" POST /api/safety/recovery/joint-motion:stop ;;
    *) die "unknown safety command: ${sub:-<missing>}" ;;
  esac
}

handle_raw() {
  local method="${1:-}" path="${2:-}"
  if [[ "$method" == "-h" || "$method" == "--help" || "$method" == "help" || -z "$method" ]]; then
    usage_raw
    return 0
  fi
  [[ -n "$method" && -n "$path" ]] || die "usage: franka raw METHOD PATH [--body JSON|@file|-] [--file FILE] [--content-type TYPE] [--output FILE]"
  shift 2
  parse_file_or_body_options "$@"
  api_request "$method" "$path" "$BODY" "$FILE" "$CONTENT_TYPE" "$OUTPUT"
}

print_bash_completion() {
  cat <<'EOF'
# Bash completion for franka.
# Generated by: franka completion bash

_franka_complete()
{
  local cur prev words cword
  _init_completion -n : 2>/dev/null || {
    COMPREPLY=()
    words=("${COMP_WORDS[@]}")
    cword=$COMP_CWORD
    cur="${words[cword]}"
    prev="${words[cword-1]}"
  }

  local global_opts groups commands opts methods paths
  global_opts="--host -u --username -p --password --control-token --token-file --no-token-file --timeout --insecure --secure -v --verbose --dry-run --json -h --help"
  groups="setup status doctor on free execution exec lock completion system control arm end-effector ee fci config safety raw"
  methods="GET POST PUT PATCH DELETE"
  paths="/api/system /api/system/control-token /api/system/control-token:take /api/system/control-token:release /api/system/operating-mode /api/system/operating-mode:change /api/system/software /api/system/software/update /api/system/log /api/arm /api/arm/joints /api/arm/joints:lock /api/arm/joints:unlock /api/arm/motion:start /api/arm/motion:stop /api/end-effector/power /api/end-effector/power:on /api/end-effector/power:off /api/fci /api/fci:activate /api/fci:deactivate /api/configuration /api/configuration/initial /api/configuration/arm-mounting /api/safety/self-tests /api/safety/self-tests:execute /api/safety/recovery /api/safety/recovery:start /api/safety/recovery:confirm /api/safety/recovery/joint-motion:start /api/safety/recovery/joint-motion:continue /api/safety/recovery/joint-motion:stop"

  case "$prev" in
    --host|--username|-u|--password|-p|--control-token|--token-file|--timeout|--control-take-timeout|--owner|--wait|--type|--token|--token-key|--content-type|--output)
      COMPREPLY=()
      return 0
      ;;
    --body)
      COMPREPLY=( $(compgen -f -- "$cur") )
      return 0
      ;;
    --file)
      COMPREPLY=( $(compgen -f -- "$cur") )
      return 0
      ;;
  esac

  local group="" group_index=0 i word
  for ((i=1; i<cword; i++)); do
    word="${words[i]}"
    case "$word" in
      --host|--username|-u|--password|-p|--control-token|--token-file|--timeout)
        ((i++))
        continue
        ;;
      --no-token-file|--insecure|--secure|-v|--verbose|--dry-run|--json|-h|--help)
        continue
        ;;
      *)
        group="$word"
        group_index=$i
        break
        ;;
    esac
  done

  if [[ -z "$group" ]]; then
    COMPREPLY=( $(compgen -W "$global_opts $groups" -- "$cur") )
    return 0
  fi

  if (( cword == group_index + 1 )); then
    case "$group" in
      status|doctor|on|lock)
        COMPREPLY=()
        ;;
      free|execution|exec)
        COMPREPLY=( $(compgen -W "--request --wait -h --help" -- "$cur") )
        ;;
      setup)
        commands="--host -u --username -p --password --token-file --timeout --control-take-timeout --insecure --secure --show --reset -h --help"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      completion)
        COMPREPLY=( $(compgen -W "bash" -- "$cur") )
        ;;
      system)
        commands="state watch operating-mode operating-mode-change software software-status-token updates updates-reset updates-prepare-online updates-prepare-offline updates-apply log public-cyclic-log public-event-log shutdown reboot"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      control)
        commands="state take request enforce release"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      arm)
        commands="info joints warnings lock unlock motion-start motion-stop"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      end-effector|ee)
        commands="power power-on power-off"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      fci)
        commands="state activate deactivate"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      config)
        commands="get patch initial arm-mounting arm-mounting-set"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      safety)
        commands="self-tests execute-self-tests log configuration-apply recovery recovery-start recovery-confirm joint-motion-start joint-motion-continue joint-motion-stop"
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        ;;
      raw)
        COMPREPLY=( $(compgen -W "$methods" -- "$cur") )
        ;;
      *)
        COMPREPLY=()
        ;;
    esac
    return 0
  fi

  local cmd="${words[group_index+1]}"
  case "$group:$cmd" in
    completion:bash|status:*|doctor:*|on:*|lock:*)
      opts=""
      ;;
    free:*|execution:*|exec:*)
      opts="--request --wait -h --help"
      ;;
    setup:*)
      opts="--host -u --username -p --password --token-file --timeout --control-take-timeout --insecure --secure --show --reset -h --help"
      ;;
    system:operating-mode-change|system:updates-prepare-online|system:updates-apply|arm:motion-start|config:patch|config:initial|config:arm-mounting-set|safety:joint-motion-start)
      opts="--body"
      ;;
    system:updates-prepare-offline|safety:configuration-apply)
      opts="--body --file --content-type --output"
      ;;
    system:log|safety:log)
      opts="--output"
      ;;
    system:shutdown|system:reboot)
      opts="--yes -y"
      ;;
    control:take)
      opts="--owner --wait --request --show-token --body"
      ;;
    control:request|control:enforce)
      opts="--owner --wait --show-token"
      ;;
    safety:recovery-start|safety:recovery-confirm)
      opts="--type"
      ;;
    safety:joint-motion-continue)
      opts="--body --token --token-key"
      ;;
    raw:GET|raw:POST|raw:PUT|raw:PATCH|raw:DELETE)
      if (( cword == group_index + 2 )); then
        COMPREPLY=( $(compgen -W "$paths" -- "$cur") )
        return 0
      fi
      opts="--body --file --content-type --output"
      ;;
    raw:*)
      if (( cword == group_index + 2 )); then
        COMPREPLY=( $(compgen -W "$methods" -- "$cur") )
        return 0
      fi
      opts="--body --file --content-type --output"
      ;;
    *)
      opts=""
      ;;
  esac

  if [[ "$cur" == -* ]]; then
    COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
  else
    COMPREPLY=()
  fi
}

complete -F _franka_complete franka
EOF
}

handle_completion() {
  local shell="${1:-}"
  case "$shell" in
    ""|-h|--help|help) usage_completion ;;
    bash) print_bash_completion ;;
    *) die "unknown completion shell: $shell" ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    -u|--username) USERNAME="$2"; shift 2 ;;
    -p|--password) PASSWORD="$2"; shift 2 ;;
    --control-token) CONTROL_TOKEN="$2"; CONTROL_TOKEN_FROM_USER=1; shift 2 ;;
    --token-file) TOKEN_FILE="$2"; TOKEN_ID_FILE="${FRANKA_DESKAPI_TOKEN_ID_FILE:-$TOKEN_FILE.id}"; shift 2 ;;
    --no-token-file) NO_TOKEN_FILE=1; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --insecure) INSECURE=1; shift ;;
    --secure) INSECURE=0; shift ;;
    -v|--verbose) VERBOSE=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --json) JSON_OUTPUT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown global option: $1" ;;
    *) break ;;
  esac
done

[[ $# -gt 0 ]] || {
  usage
  exit 2
}

load_token

group="$1"
shift
case "$group" in
  setup) handle_setup "$@" ;;
  status|doctor) handle_status "$@" ;;
  on) workflow_on "$@" ;;
  free) workflow_free "$@" ;;
  execution|exec) workflow_execution "$@" ;;
  lock) workflow_lock "$@" ;;
  completion) handle_completion "$@" ;;
  system) handle_system "$@" ;;
  control) handle_control "$@" ;;
  arm) handle_arm "$@" ;;
  end-effector|ee) handle_end_effector "$@" ;;
  fci) handle_fci "$@" ;;
  config) handle_config "$@" ;;
  safety) handle_safety "$@" ;;
  raw) handle_raw "$@" ;;
  *) die "unknown group: $group" ;;
esac
